# EcoTrace Backend Environment Variables

# JWT Secret Key
SECRET_KEY=ecotrace-super-secret-jwt-key-2026-sustainability-auth

# Database URL
# Default SQLite local database:
DATABASE_URL=sqlite:///./ecotrace.db

# Or connect directly to Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Emission Factors (Central Electricity Authority India baseline)
ELECTRICITY_EMISSION_FACTOR=0.82
LPG_EMISSION_FACTOR_PER_KG=2.983
LPG_KG_PER_HOUR_MEDIUM=0.15
