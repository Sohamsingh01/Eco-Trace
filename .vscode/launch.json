{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: EcoTrace Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Edge/Chrome: EcoTrace Frontend",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Browser",
      "configurations": [
        "Python: EcoTrace Backend (FastAPI)",
        "Edge/Chrome: EcoTrace Frontend"
      ]
    }
  ]
}
